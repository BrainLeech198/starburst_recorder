# ─────────── 依赖 ───────────
node_modules/

# ─────────── 本机产物，统一收在 .local/ ───────────
# Vite 产物（.local/dist）、Electron 免安装目录（.local/release）、
# 安装包与发版说明（.local/artifacts）、截图（.local/screenshots）、
# 参考资料与 AI 记忆（.local/refs、.local/ai-memory）、
# 签名密钥（.local/keys）、临时文件（.local/tmp）
.local/

# ─────────── Web Push 中继 ───────────
# wrangler dev 读的本地密钥文件（VAPID 私钥），绝不进仓库
worker/push/.dev.vars
worker/push/.wrangler/

# ─────────── 本地环境变量 ───────────
# 网页版的 VITE_PUSH_API / VITE_VAPID_PUBLIC_KEY / VITE_AI_PROXY 都放这里
.env.local
.env.*.local

# ─────────── Android ───────────
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/capacitor-cordova-android-plugins/build/

# ─────────── 其它 AI 工具的本机产物 ───────────
# .workbuddy-ai/memory 是别的工具自己写的记忆，.trae-html-share-packages 是分享用的打包副本
.workbuddy-ai/
.trae-html-share-packages/
# CODEBUDDY.md 是另一个工具留的本机备忘，内容已过期（记的还是 0.3.0 时期的发版占用）
CODEBUDDY.md

# ─────────── 编辑器与系统 ───────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ─────────── 日志 ───────────
logs/
*.log
npm-debug.log*
