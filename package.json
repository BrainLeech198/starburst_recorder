{
  "name": "starburst-recorder",
  "private": true,
  "license": "MIT",
  "version": "0.6.1",
  "type": "module",
  "description": "星芒记录者 —— 本地优先的个人记录工具，内置 AI 整理",
  "author": "starburst",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node package/run-tests.cjs run",
    "test:watch": "node package/run-tests.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --dir",
    "desktop:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File package/windows/build.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.starburst.recorder",
    "productName": "星芒记录者",
    "files": [
      ".local/dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/@capacitor/**/*",
      "package/windows/icon.ico"
    ],
    "directories": {
      "output": ".local/release"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "afterPack": "package/windows/afterPack.cjs",
    "electronDist": "node_modules/electron/dist",
    "win": {
      "executableName": "starburst-recorder",
      "icon": "package/windows/icon.ico"
    }
  }
}
